pipeline {
	agent any

	stages {

		stage('Checkout') {
			steps {
				checkout scm
			}
		}

		stage('Build') {
			steps {
				sh '''
                    cd Week5/task
                    python3 -m venv myenv
                    myenv/bin/pip install -r requirements.txt
                '''
			}
		}

		stage('Test') {
			steps {
				sh '''
                    cd Week5/task
                    myenv/bin/pytest
                '''
			}
		}
	}
}