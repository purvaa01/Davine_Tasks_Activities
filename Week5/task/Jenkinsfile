pipeline {
	agent any

	stages {

		stage('Checkout') {
			steps {
				checkout scm
			}
		}

		stage('Build') {
			steps {
				sh '''
                    python3 -m venv myenv
                    myenv/bin/activate  
                    pip install -r requirements.txt
                '''
			}
		}

		stage('Test') {
			steps {
				sh '''
                    pip install pytest 
                    pytest
                '''
			}
		}
	}
}